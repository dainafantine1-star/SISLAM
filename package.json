{
  "name": "sislam",
  "version": "0.1.0",
  "private": true,
  "description": "SISLAM — Sistema Inteligente de Licenciamento e Gestão Ambiental",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "setup": "tsx api/setup.ts",
    "api": "tsx api/main.ts",
    "web": "next dev --webpack -p 3400",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "tsx scripts/backup.ts",
    "verify:backup": "tsx scripts/verify-backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test:browser": "node scripts/browser-test.cjs",
    "format": "prettier --write api src scripts tests *.json *.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@electric-sql/pglite": "^0.5.16",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.560.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
